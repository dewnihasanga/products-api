
@startuml

class Product {
    - id : Long
    - name : String
    - price : double

    + Product()
    + Product(id : Long, name : String, price : double)
    + getId() : Long
    + getName() : String
    + getPrice() : double
}

class Address {
    - street : String
    - city : String
    - postcode : String

    + Address()
    + Address(street : String, city : String, postcode : String)
    + getStreet() : String
    + getCity() : String
    + getPostcode() : String
}

Product --> Address

@enduml
